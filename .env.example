# Copy to .env locally. Never commit real credentials.
PORT=3000
HOST=127.0.0.1
# Enable only for a loopback-bound origin behind this Mac's trusted tunnel.
TRUST_LOOPBACK_PROXY=false
PUBLIC_ORIGIN=http://localhost:3000
DATABASE_PATH=./data/aragoz.db
# Base64-encoded 32-byte key, generated locally. Required for Twitch credentials.
CREDENTIAL_ENCRYPTION_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3000/api/auth/twitch/callback
# Comma-separated numeric broadcaster IDs. Empty means hosting is disabled.
INVITED_BROADCASTER_IDS=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Calls remain disabled until a non-zero operator-approved daily request cap is set.
MODEL_DAILY_REQUEST_LIMIT=0
MAX_ACTIVE_SHOWS=3
RAW_PROPOSAL_RETENTION_HOURS=24
NODE_ENV=development
